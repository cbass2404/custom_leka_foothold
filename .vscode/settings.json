{
  // Individual files rather than the directories they sit in. "Common Scripts"
  // is 14 MB, almost all of it Moose and Foothold_Localization, which nothing
  // here touches; "Setup files" holds ten setups that each assign the same
  // globals with different values, and only the Coldwar one matches our mission.
  // zoneCommanderv2 defines BattleCommander, ZoneCommander and Frontline;
  // COLDWAR_SETUP defines bc.
  //
  // Foothold is a nested git repo, so ignoreSubmodules and useGitIgnore both
  // keep the workspace scan out of it. Naming the files here is what gets them
  // read at all.
  "Lua.workspace.library": [
    "../dcs_script_library",
    "Lekas-Foothold/Common Scripts/zoneCommanderv2.lua",
    "Lekas-Foothold/Setup files/COLDWAR_SETUP.lua"
  ],

  // zoneCommanderv2 is 4.5 MB and grows with upstream; the default cap is
  // 500 KB, and a file over the cap is skipped without warning. Set far above
  // anything upstream will reach rather than tracked: the library above names
  // individual files, never directories, so a high cap cannot pull in anything
  // large we did not ask for.
  "Lua.workspace.preloadFileSize": 50000,

  "Lua.diagnostics.disable": ["deprecated"],
  "Lua.runtime.version": "Lua 5.1"
}
